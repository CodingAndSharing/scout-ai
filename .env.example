# Copy to .env and fill in what you use:  cp .env.example .env
# .env is gitignored and dockerignored. docker compose loads it automatically
# (env_file: in docker-compose.yaml); a local shell does not — use
#   set -a; . ./.env; set +a
# or direnv, because nothing in the Ruby code reads .env by itself.
#
# NAMES MATTER: scout-ai resolves <BACKEND>_KEY, not <BACKEND>_API_KEY.
# OPENAI_API_KEY is read by nothing — see README_dev §2.3.1 / audit #21.

# --- Providers -------------------------------------------------------------
OPENAI_KEY=
ANTHROPIC_KEY=          # ANTHROPIC_API_KEY also works, via the anthropic gem
OPENROUTER_KEY=         # used through the openai backend + url, see §2.3.2
HF_TOKEN=               # only to download gated Hugging Face checkpoints
# GLM_KEY=
# VLLM_KEY=
# OPENWEBUI_KEY=

# AWS Bedrock uses the standard AWS variables instead of <BACKEND>_KEY:
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Which model answers ---------------------------------------------------
# Two ways, both honoured by docker-compose.yaml.
#
# (a) Straight from here — no YAML file anywhere. Verified: backend + url +
#     model resolve from these three variables alone.
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL defaults to http://ollama:11434 (the compose service) — override
# it only to reach an Ollama outside the compose network:
# OLLAMA_URL=http://host.docker.internal:11434

# Same shape for the other backends:
# LLM_BACKEND=openai
# OPENAI_MODEL=gpt-4o
# LLM_BACKEND=anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-5

# (b) …or name a saved endpoint in ~/.scout/etc/AI/<name>.yaml, which can also
#     carry url/model/backend and per-endpoint options. Overrides nothing else.
# ASK_ENDPOINT=openrouter

# --- Container knobs (docker-compose.yaml) ---------------------------------
# SCOUT_PORT=4567
# OLLAMA_PORT=11434
