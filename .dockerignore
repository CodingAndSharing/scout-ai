# The host's pixi environment is a full conda install and must never enter the image:
# the image builds its own in layer 1.
.pixi/
.git/
.gitignore

# Local state and scratch — bulky, machine-specific, and would invalidate the
# source layer on every local run.
chats/
tmp/
var/
pkg/
sandbox/
archived/
venv/
__pycache__/
*.pyc

# Secrets never belong in a build context.
.env

# Not needed at runtime.
research/
Dockerfile
docker-compose.yaml
.dockerignore
